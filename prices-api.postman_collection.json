      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response matches expected applicable price\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.productId).to.eql(35455);",
              "    pm.expect(json.brandId).to.eql(1);",
              "    pm.expect(json.priceList).to.eql(1);",
              "    pm.expect(json.startDate).to.eql(\"2020-06-14T00:00:00\");",
              "    pm.expect(json.endDate).to.eql(\"2020-12-31T23:59:59\");",
              "    pm.expect(Number(json.price)).to.eql(35.50);",
              "    pm.expect(json.currency).to.eql(\"EUR\");",
              "});"
            ]
          }
        }
